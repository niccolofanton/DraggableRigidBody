{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client", "node"],
    // the component lives one level above this folder, outside any node_modules
    // scope: this lets tsc resolve its bare imports against the demo's deps
    "baseUrl": ".",
    "paths": {
      "react": ["node_modules/@types/react"],
      "react/jsx-runtime": ["node_modules/@types/react/jsx-runtime"],
      "three": ["node_modules/@types/three"],
      "@react-three/fiber": ["node_modules/@react-three/fiber"],
      "@react-three/rapier": ["node_modules/@react-three/rapier"],
      "@react-three/drei/*": ["node_modules/@react-three/drei/*"],
      "@use-gesture/react": ["node_modules/@use-gesture/react"]
    }
  },
  "include": ["src", "vite.config.ts", "../DraggableRigidBody.tsx", "../CustomDragControls.tsx"]
}
